{
  "name": "yearning-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "VITE_ENABLE_MOCK=true VITE_DEMO_MODE=true VITE_BUILD_OUT_DIR=dist-demo VITE_DOCS_URL=https://v4.yearning.io/ vite build",
    "preview": "vite preview",
    "preview:demo": "VITE_BUILD_OUT_DIR=dist-demo vite preview --host 0.0.0.0 --port 4179",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:frames": "MOTION_FRAMES_ONLY=1 playwright test tests/e2e/motion-frames.spec.ts --workers=1",
    "test:e2e:invariants": "playwright test --config playwright.invariants.config.ts",
    "screenshots": "./scripts/e2e-container.sh run",
    "screenshots:update": "./scripts/e2e-container.sh update",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:tokens": "node scripts/check-token-contrast.mjs",
    "check:colors": "node scripts/scan-raw-colors.mjs",
    "check:prohibited": "node scripts/scan-prohibited.mjs",
    "check:motion": "node scripts/scan-motion.mjs && node scripts/scan-motion.mjs --self-test",
    "check:assets": "node scripts/check-assets.mjs",
    "check:registry": "node scripts/generate-registry-inventory.mjs --check",
    "check:mock-routes": "node scripts/generate-mock-routes.mjs --check",
    "check:record-fixtures": "node scripts/record-real-fixtures.mjs --self-test",
    "api:generate": "orval --config orval.config.ts && node scripts/generate-projections.mjs && node scripts/generate-contract-manifest.mjs",
    "api:manifest": "node scripts/generate-contract-manifest.mjs",
    "api:breaking": "node scripts/api-breaking.mjs --self-test && node scripts/api-breaking.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:bundle:verify": "node scripts/check-bundle-budget.mjs --no-write",
    "check:storage": "node scripts/scan-browser-storage.mjs",
    "check:ratchets": "node scripts/check-ratchets.mjs && node scripts/check-ratchets.mjs --self-test",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "contract:diff": "node scripts/contract-diff.mjs",
    "record:fixtures": "node scripts/record-real-fixtures.mjs",
    "test:e2e:real": "playwright test --config playwright.real.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-virtual": "3.14.10",
    "@tiptap/markdown": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fflate": "^0.8.3",
    "i18next": "26.4.0",
    "lucide-react": "1.37.0",
    "monaco-editor": "^0.56.0",
    "motion": "^13.2.0",
    "react": "19.2.8",
    "react-day-picker": "9.11.1",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.12",
    "react-resizable-panels": "^4.12.3",
    "react-router": "8.3.1",
    "recharts": "3.8.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@oasdiff-js/oasdiff-js": "1.0.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "25.6.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.12",
    "agentation": "^3.1.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "jsdom": "30.1.3",
    "msw": "2.15.0",
    "orval": "8.27.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "3.4.17",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
      "fast-uri@>=3.0.0 <3.1.9": "^3.1.9",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "markdown-it@<14.3.3": "^14.3.3",
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "undici@>=8.0.0 <8.12.2": "^8.12.2"
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
