{
  "contract_version": 1,
  "algorithm_version": "yearning-fingerprint-v1",
  "notes": "全部语句为合成样本，不含生产数据。expected_canonical/dialect/shape为固定测试密钥下的冻结HMAC（hex小写），同版本必须逐字节可复现。",
  "test_key_id": "golden-key-1",
  "equivalence_groups": {
    "insert_basic": [
      "mysql_insert_backtick",
      "mysql_insert_bare",
      "pg_insert_plain",
      "tidb_insert",
      "oceanbase_insert",
      "polardb_mysql_insert"
    ],
    "limit_fold": [
      "mysql_limit_comma",
      "pg_limit_offset"
    ],
    "quoting_surface": [
      "mysql_select_quoted",
      "pg_select_quoted"
    ]
  },
  "difference_pairs": [
    [
      "mysql_insert_backtick",
      "pg_insert_returning"
    ],
    [
      "mysql_insert_backtick",
      "tidb_insert"
    ],
    [
      "mysql_update_simple",
      "mysql_update_inlist"
    ],
    [
      "mysql_where_int",
      "mysql_where_string"
    ]
  ],
  "cases": [
    {
      "id": "mysql_insert_backtick",
      "profile": "mysql/mysql",
      "sql": "INSERT INTO `orders` (`id`,`status`) VALUES (1,'new')",
      "expect": {
        "kind": "insert",
        "quality": "exact",
        "literal_types": {
          "int": 1,
          "string": 1
        },
        "parameter_count": 2,
        "tuple_count": 1,
        "anonymized_contains": [
          "table_1",
          "column_1",
          ":int",
          ":string"
        ],
        "anonymized_absent": [
          "orders",
          "status",
          "new"
        ]
      }
    },
    {
      "id": "mysql_insert_bare",
      "profile": "mysql/mysql",
      "sql": "INSERT INTO orders (id,status) VALUES (2,'done')",
      "expect": {
        "kind": "insert",
        "quality": "exact"
      }
    },
    {
      "id": "pg_insert_plain",
      "profile": "postgresql/postgresql",
      "sql": "INSERT INTO orders (id,status) VALUES (1,'new')",
      "expect": {
        "kind": "insert",
        "quality": "exact"
      }
    },
    {
      "id": "pg_insert_returning",
      "profile": "postgresql/postgresql",
      "sql": "INSERT INTO orders (id,status) VALUES (1,'new') RETURNING id",
      "expect": {
        "kind": "insert",
        "quality": "exact",
        "features_include": [
          "returning"
        ]
      }
    },
    {
      "id": "tidb_insert",
      "profile": "tidb/mysql",
      "sql": "INSERT INTO orders (id,status) VALUES (1,'new')",
      "expect": {
        "kind": "insert",
        "quality": "exact"
      }
    },
    {
      "id": "oceanbase_insert",
      "profile": "oceanbase/mysql",
      "sql": "INSERT INTO orders (id,status) VALUES (1,'new')",
      "expect": {
        "kind": "insert",
        "quality": "exact"
      }
    },
    {
      "id": "polardb_mysql_insert",
      "profile": "polardb/mysql",
      "sql": "INSERT INTO orders (id,status) VALUES (1,'new')",
      "expect": {
        "kind": "insert",
        "quality": "exact"
      }
    },
    {
      "id": "polardb_pg_insert",
