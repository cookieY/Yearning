      "id": "mysql_update_inlist",
      "profile": "mysql/mysql",
      "sql": "UPDATE orders SET status = 'processed' WHERE id IN (1,2,3)",
      "expect": {
        "kind": "update",
        "quality": "exact",
        "in_list_sizes": [
          3
        ],
        "anonymized_contains": [
          ":int[3]"
        ],
        "anonymized_absent": [
          "processed"
        ]
      }
    },
    {
      "id": "pg_dollar_quote_semicolon",
      "profile": "postgresql/postgresql",
