        "anonymized_absent": [
          "idx_status"
        ]
      }
    },
    {
      "id": "pg_create_index_concurrently",
      "profile": "postgresql/postgresql",
      "sql": "CREATE INDEX CONCURRENTLY idx_orders_status ON orders (status)",
      "expect": {
        "kind": "create",
        "quality": "exact",
        "features_include": [
